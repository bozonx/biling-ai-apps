DATABASE_URL=postgresql://billing:billing@localhost:5433/billing
REDIS_HOST=localhost
REDIS_PORT=6380
API_PORT=3010
GATEWAY_PORT=3011

# Local development only; all visitors share this account
NODE_ENV=development
DEV_ACCOUNT_ENABLED=false
DEV_ACCOUNT_ID=0193a000-0000-7000-8000-000000000002
# Printed by `pnpm db:seed`
DEV_PRODUCT_ID=0193a000-0000-7000-8000-000000000001

# Staff OIDC access tokens; issuer/subject must have IdentityBinding and StaffRole
STAFF_OIDC_ISSUER=
STAFF_OIDC_AUDIENCE=
STAFF_OIDC_JWKS_URL=

# Optional AI provider credentials (gateway only)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
GROQ_API_KEY=
