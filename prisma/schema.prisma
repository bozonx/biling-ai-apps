// ============================================================================
// Продукты (§7.1)
// ============================================================================

model Product {
  display   Json          @default("{}")
  id        String        @id @default(uuid(7)) @db.Uuid
  /// неизменяем после создания
  code      String        @unique // 'tyco', 'fastcat'
  name      String
  status    ProductStatus @default(active)
  /// грейсы, окно позднего commit, параметры lease, флаги (§8.6, §8.7, §12.2)
  settings  Json          @default("{}")
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  entitlementKeys      ProductEntitlementKey[]
  quotaKeys            ProductQuotaKey[]
  creditRateVersions   CreditRateVersion[]
  markupPolicyVersions MarkupPolicyVersion[]
  creditPacks          CreditPack[]
  features             ProductFeature[]
  modelRoutes          ProductModelRoute[]
  teamAccounts         BillingAccount[]
  wallets              CreditWallet[]
  buckets              CreditBucket[]
  operations           CreditOperation[]
  ledgerEntries        CreditLedgerEntry[]
  holds                CreditHold[]
  purchases            Purchase[]
  planGrants           PlanGrant[]
  referrals            Referral[]
  referralRewards      ReferralReward[]
  entitlementOverrides EntitlementOverride[]
  limitOverrides       LimitOverride[]
  limitPolicies        LimitPolicy[]
  quotaUsages          QuotaUsage[]
  quotaReservations    QuotaReservation[]
  quotaSnapshots       QuotaUsageSnapshot[]
  apiKeys              ProductApiKey[]
  webhookEndpoints     ProductWebhookEndpoint[]
  outboxEvents         OutboxEvent[]
  checkoutSessions     CheckoutSession[]
}

/// Реестр прав продукта (§6.1)
model ProductEntitlementKey {
  id             String           @id @default(uuid(7)) @db.Uuid
  productId      String           @db.Uuid
  key            String // 'ai.model_tier'
  type           EntitlementType
  merge          EntitlementMerge
  enumValues     String[] // для type=enum, по возрастанию (для merge=max и требований «≥»)
  keepOnReadOnly Boolean          @default(false)
  description    String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, key])
}

// ============================================================================
// Identity и аккаунты (§5)
// ============================================================================

/// Постоянный actorId. Внешние пары (issuer, subject) — в IdentityBinding.
model Identity {
  id        String    @id @default(uuid(7)) @db.Uuid // = actorId
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  ownedAccounts   BillingAccount[] @relation("AccountOwner")
  personalAccount BillingAccount?  @relation("PersonalAccount")
  staffRoles      StaffRole[]
  auditLogs       AdminAuditLog[]

  bindings IdentityBinding[]
}

/// personalOwnerId = ownerIdentityId у personal, NULL у team — обычная
/// уникальность «один личный аккаунт на человека» без частичного индекса.
/// RAW: CHECK ((kind = 'personal') = (personalOwnerId IS NOT NULL))
/// RAW: CHECK (personalOwnerId IS NULL OR personalOwnerId = ownerIdentityId)
model BillingAccount {
  locale          String        @default("en-US")
  id              String        @id @default(uuid(7)) @db.Uuid
  kind            AccountKind   @default(personal)
  ownerIdentityId String?       @db.Uuid
  personalOwnerId String?       @unique @db.Uuid
  productId       String?       @db.Uuid // team: продукт команды
  externalRef     String? // team: id команды в продукте
  country         String?       @db.Char(2)
  email           String?
  status          AccountStatus @default(active)
  /// флаг проверки после chargeback (§8.10)
  reviewFlag      Boolean       @default(false)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  owner         Identity? @relation("AccountOwner", fields: [ownerIdentityId], references: [id], onDelete: Restrict)
  personalOwner Identity? @relation("PersonalAccount", fields: [personalOwnerId], references: [id], onDelete: Restrict)
  product       Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)

  customers            AccountCustomer[]
  wallets              CreditWallet[]
  buckets              CreditBucket[]
  operations           CreditOperation[]
  ledgerEntries        CreditLedgerEntry[]
  holds                CreditHold[]
  subscriptions        Subscription[]
  purchases            Purchase[]
  payments             Payment[]
  planGrants           PlanGrant[]
  partner              Partner?
  referredBy           Referral[]            @relation("ReferredAccount")
  referralRewards      ReferralReward[]
  promotionRedemptions PromotionRedemption[]
  entitlementOverrides EntitlementOverride[]
  limitOverrides       LimitOverride[]
  quotaUsages          QuotaUsage[]
  quotaReservations    QuotaReservation[]
  quotaSnapshots       QuotaUsageSnapshot[]
  checkoutSessions     CheckoutSession[]

  @@unique([productId, externalRef])
  @@index([ownerIdentityId])
}

/// Клиент у источника оплаты (§5.2)
model AccountCustomer {
  id                 String        @id @default(uuid(7)) @db.Uuid
  accountId          String        @db.Uuid
  source             PaymentSource
  externalCustomerId String
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)

  account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([source, externalCustomerId])
  @@unique([accountId, source])
}

// ============================================================================
// Каталог (§7). Версия: publishedAt IS NULL — черновик, иначе неизменяема.
// RAW: триггер immutable_after_publish на всех *Version / FeaturePrice.
// ============================================================================

model CreditRateVersion {
  id                String    @id @default(uuid(7)) @db.Uuid
  productId         String    @db.Uuid
  version           Int
  creditValueMicros BigInt // цена 1 кредита в микро-USD
  effectiveFrom     DateTime  @db.Timestamptz(3)
  publishedAt       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  buckets CreditBucket[]

  @@unique([productId, version])
  @@index([productId, effectiveFrom])
}

model MarkupPolicyVersion {
  id             String    @id @default(uuid(7)) @db.Uuid
  productId      String    @db.Uuid
  version        Int
  /// ступени наценки по стоимости модели (§10.5)
  tiers          Json
  minChargeMilli BigInt?
  effectiveFrom  DateTime  @db.Timestamptz(3)
  publishedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, version])
  @@index([productId, effectiveFrom])
}

model Plan {
  display      Json       @default("{}")
  id           String     @id @default(uuid(7)) @db.Uuid
  /// коды продуктов (Product.code), которые покрывает тариф; бандл — несколько
  productScope String[]
  code         String     @unique
  name         String
  kind         PlanKind
  visibility   Visibility @default(public)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  defaultGrants      PlanGrant[]
  versions           PlanVersion[]
  requiredByVersions PlanVersion[] @relation("RequiresBasePlan")
}

/// Неизменяема после publishedAt (инвариант 7)
model PlanVersion {
  trialCreditGrants        Json            @default("{}")
  creditGrantInterval      BillingInterval @default(month)
  creditGrantIntervalCount Int             @default(1)
  revokedAt                DateTime?       @db.Timestamptz(3)
  id                       String          @id @default(uuid(7)) @db.Uuid
  planId                   String          @db.Uuid
  version                  Int
  /// { tyco: { 'ai.enabled': true, ... } }
  entitlements             Json            @default("{}")
  /// { fastcat: { 'storage.bytes': 10737418240 } }
  quotas                   Json            @default("{}")
  /// { tyco: 500000 } — милли-кредиты за месяц
  creditGrants             Json            @default("{}")
  /// { tyco: LimitRule[] } (§8.8)
  limits                   Json            @default("{}")
  /// прочие правила версии (addon: «любой платный базовый», fallbackCredits)
  rules                    Json            @default("{}")
  requiresBasePlanId       String?         @db.Uuid
  effectiveFrom            DateTime        @db.Timestamptz(3)
  /// конец продаж версии (не конец действия у подписчиков)
  effectiveTo              DateTime?       @db.Timestamptz(3)
  publishedAt              DateTime?       @db.Timestamptz(3)
  createdAt                DateTime        @default(now()) @db.Timestamptz(3)

  plan             Plan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  requiresBasePlan Plan? @relation("RequiresBasePlan", fields: [requiresBasePlanId], references: [id], onDelete: Restrict)

  offers                 Offer[]
  subscriptions          Subscription[]      @relation("SubscriptionPlanVersion")
  scheduledSubscriptions Subscription[]      @relation("SubscriptionScheduledPlanVersion")
  subscriptionEventsFrom SubscriptionEvent[] @relation("SubEventFromPlan")
  subscriptionEventsTo   SubscriptionEvent[] @relation("SubEventToPlan")
  payments               Payment[]
  planGrants             PlanGrant[]
  referralRewards        ReferralReward[]

  @@unique([planId, version])
  @@index([requiresBasePlanId])
}

/// Как версия продаётся через источник (§7.1).
/// externalPriceId уникален у источника: новая версия тарифа или регион MoR —
/// новая цена у источника. Для магазинов amountMicros — ориентир, фактическая
/// сумма приходит в Payment.
model Offer {
  id              String          @id @default(uuid(7)) @db.Uuid
  planVersionId   String          @db.Uuid
  source          PaymentSource
  interval        BillingInterval
  intervalCount   Int             @default(1) // 3 × month = квартал
  trialDays       Int             @default(0)
  externalPriceId String?
  amountMicros    BigInt
  currency        String          @db.Char(3)
  region          String? // PPP
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  planVersion            PlanVersion       @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  subscriptions          Subscription[]    @relation("SubscriptionOffer")
  scheduledSubscriptions Subscription[]    @relation("SubscriptionScheduledOffer")
  payments               Payment[]
  checkoutSessions       CheckoutSession[]

  @@index([source, externalPriceId])
  @@index([planVersionId])
}

model CreditPack {
  display      Json       @default("{}")
  id           String     @id @default(uuid(7)) @db.Uuid
  productId    String     @db.Uuid
  code         String
  creditsMilli BigInt
  validityDays Int        @default(365)
  visibility   Visibility @default(public)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  product Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  offers  CreditPackOffer[]

  @@unique([productId, code])
}

/// Снимок состава пакета (creditsMilli, validityDays) — в Purchase на момент
/// покупки, поэтому CreditPack можно править без версий.
model CreditPackOffer {
  id              String        @id @default(uuid(7)) @db.Uuid
  creditPackId    String        @db.Uuid
  source          PaymentSource
  externalPriceId String?
  amountMicros    BigInt
  currency        String        @db.Char(3)
  region          String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  creditPack       CreditPack        @relation(fields: [creditPackId], references: [id], onDelete: Restrict)
  purchases        Purchase[]
  checkoutSessions CheckoutSession[]

  /// не уникален: региональные цены живут внутри одной цены источника (как у Offer)
  @@index([source, externalPriceId])
  @@index([creditPackId])
}

/// Реестр платных действий продукта (§7.1)
model ProductFeature {
  display           Json           @default("{}")
  id                String         @id @default(uuid(7)) @db.Uuid
  productId         String         @db.Uuid
  key               String
  /// требования к правам: { 'ai.enabled': true, 'ai.model_tier': 'pro' }
  /// bool — равенство, int/enum — «не меньше» (по порядку enumValues)
  requires          Json           @default("{}")
  pricing           FeaturePricing
  defaultRouteId    String?        @db.Uuid
  defaultHoldTtlSec Int            @default(300)
  status            FeatureStatus  @default(active)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  defaultRoute ModelRoute?    @relation(fields: [defaultRouteId], references: [id], onDelete: Restrict)
  prices       FeaturePrice[]
  holds        CreditHold[]

  @@unique([productId, key])
}

/// Фиксированная цена действия, версионно (§10.5)
model FeaturePrice {
  unit          String    @default("action")
  per           BigInt    @default(1)
  id            String    @id @default(uuid(7)) @db.Uuid
  featureId     String    @db.Uuid
  version       Int
  creditsMilli  BigInt
  effectiveFrom DateTime  @db.Timestamptz(3)
  publishedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  feature ProductFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)
  holds   CreditHold[]

  @@unique([featureId, version])
  @@index([featureId, effectiveFrom])
}

/// Этап 4+ (§7.3, §8.5)
model Promotion {
  id                 String        @id @default(uuid(7)) @db.Uuid
  code               String        @unique
  kind               PromotionKind
  rules              Json
  externalDiscountId String? // kind=discount: id купона у MoR
  startsAt           DateTime?     @db.Timestamptz(3)
  endsAt             DateTime?     @db.Timestamptz(3)
  maxRedemptions     Int?
  maxPerAccount      Int?
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  redemptions      PromotionRedemption[]
  checkoutSessions CheckoutSession[]
}

/// Погашение акции: идемпотентность и лимиты считаются по строкам
model PromotionRedemption {
  id             String   @id @default(uuid(7)) @db.Uuid
  promotionId    String   @db.Uuid
  accountId      String   @db.Uuid
  idempotencyKey String // напр. 'payment:<paymentId>'; уникален в пределах акции
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  promotion Promotion      @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  account   BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([promotionId, idempotencyKey])
  @@index([promotionId, accountId])
  @@index([accountId])
}

// ============================================================================
// Кредиты (§8)
// ============================================================================

/// Материализация + строка блокировки (SELECT ... FOR UPDATE).
/// RAW: CHECK (balanceMilli >= 0 AND heldMilli >= 0 AND debtMilli >= 0)
model CreditWallet {
  lastOperationSeq BigInt    @default(0)
  nextAccrualAt    DateTime? @db.Timestamptz(3)
  nextExpiryAt     DateTime? @db.Timestamptz(3)
  accountId        String    @db.Uuid
  productId        String    @db.Uuid
  balanceMilli     BigInt    @default(0)
  heldMilli        BigInt    @default(0)
  debtMilli        BigInt    @default(0)
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([accountId, productId])
  @@index([nextAccrualAt])
  @@index([nextExpiryAt])
}

/// Идемпотентная операция над кошельком: одна строка на бизнес-операцию,
/// её записи журнала пишутся в той же транзакции. Ключ детерминирован:
///   'accrual:sub:<subscriptionId>:<portionStart>'
///   'accrual:grant:<planGrantId>:<portionStart>'
///   'upgrade:<subscriptionId>:<portionStart>:<planVersionId>'
///   'purchase:<purchaseId>', 'commit:<holdId>:<n>', 'expiry:<bucketId>' …
/// Поэтому повторная обработка вебхука или параллельное ленивое начисление
/// не создают второй партии. Только дописывается (RAW-триггер).
model CreditOperation {
  walletSeq         BigInt
  balanceAfterMilli BigInt
  debtAfterMilli    BigInt
  id                String              @id @default(uuid(7)) @db.Uuid
  accountId         String              @db.Uuid
  productId         String              @db.Uuid
  kind              CreditOperationKind
  operationKey      String
  actorId           String?             @db.Uuid // мягкая ссылка на Identity
  meta              Json                @default("{}")
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)

  account       BillingAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  ledgerEntries CreditLedgerEntry[]
  buckets       CreditBucket[]

  @@unique([accountId, productId, walletSeq])
  @@unique([id, accountId, productId])
  @@unique([productId, operationKey])
  @@index([accountId, productId, createdAt])
}

/// RAW: CHECK (remainingMilli >= 0 AND remainingMilli <= grantedMilli AND grantedMilli > 0)
model CreditBucket {
  id                  String           @id @default(uuid(7)) @db.Uuid
  accountId           String           @db.Uuid
  productId           String           @db.Uuid
  kind                CreditBucketKind
  grantedMilli        BigInt
  remainingMilli      BigInt // материализация
  expiresAt           DateTime?        @db.Timestamptz(3)
  expiredAt           DateTime?        @db.Timestamptz(3) // сожжена воркером
  creditRateVersionId String           @db.Uuid
  sourceType          CreditSourceType
  sourceId            String // id источника (подписки, гранта, покупки…)
  periodStart         DateTime?        @db.Timestamptz(3) // начало порции
  operationId         String           @db.Uuid // операция, создавшая партию
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)

  account           BillingAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  creditRateVersion CreditRateVersion   @relation(fields: [creditRateVersionId], references: [id], onDelete: Restrict)
  operation         CreditOperation     @relation(fields: [operationId, accountId, productId], references: [id, accountId, productId], onDelete: Restrict)
  ledgerEntries     CreditLedgerEntry[]
  purchase          Purchase?

  @@unique([id, accountId, productId])
  @@index([accountId, productId, expiresAt])
  @@index([sourceType, sourceId])
  @@index([expiredAt, expiresAt]) // воркер сгорания: expiredAt IS NULL AND expiresAt < now()
}

/// Только дописывается (RAW-триггер). No partitioning.
/// Идемпотентность — у CreditOperation.
/// RAW: CHECK (amountMilli <> 0)
/// RAW: CHECK ((bucketId IS NULL) = (reason = 'debt'))
model CreditLedgerEntry {
  id           String       @id @default(uuid(7)) @db.Uuid
  operationId  String       @db.Uuid
  accountId    String       @db.Uuid
  productId    String       @db.Uuid
  bucketId     String?      @db.Uuid // NULL для debt
  amountMilli  BigInt // +/-
  reason       LedgerReason
  actorId      String?      @db.Uuid // мягкая ссылка на Identity
  usageEventId String?      @db.Uuid // мягкая ссылка (инвариант 12)
  holdId       String?      @db.Uuid // мягкая ссылка: резервы можно чистить
  paymentId    String?      @db.Uuid
  meta         Json         @default("{}")
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  operation CreditOperation @relation(fields: [operationId, accountId, productId], references: [id, accountId, productId], onDelete: Restrict)
  account   BillingAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  bucket    CreditBucket?   @relation(fields: [bucketId, accountId, productId], references: [id, accountId, productId], onDelete: Restrict)
  payment   Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([usageEventId])
  @@index([accountId, productId, createdAt])
  @@index([operationId])
  @@index([bucketId])
  @@index([holdId])
  @@index([paymentId])
}

/// hold — под одно действие (featureId обязателен); lease — пачка на
/// (account, product, actor) для многих действий (§8.7).
/// RAW: CHECK (kind = 'lease' OR featureId IS NOT NULL)
/// RAW: CHECK (amountMilli > 0 AND committedMilli >= 0)
/// RAW: CHECK (routePriceVersionId IS NULL OR featurePriceId IS NULL)
model CreditHold {
  id                  String     @id @default(uuid(7)) @db.Uuid
  accountId           String     @db.Uuid
  productId           String     @db.Uuid
  actorId             String?    @db.Uuid
  featureId           String?    @db.Uuid
  routeId             String?    @db.Uuid
  amountMilli         BigInt
  committedMilli      BigInt     @default(0)
  /// цена, по которой сделана оценка: маршрута или фиксированная
  routePriceVersionId String?    @db.Uuid
  featurePriceId      String?    @db.Uuid
  kind                HoldKind   @default(hold)
  status              HoldStatus @default(open)
  expiresAt           DateTime   @db.Timestamptz(3)
  closedAt            DateTime?  @db.Timestamptz(3)
  idempotencyKey      String
  /// окна лимитов, в которых резерв занял `reserved`: [{ scopeKey, windowStart, meter, amount }]
  /// — по ним release/expire возвращают ровно то, что заняли, даже если правила сменились
  limitReservations   Json       @default("[]")
  estimatedCostNanos  BigInt?
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)

  account           BillingAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  feature           ProductFeature?    @relation(fields: [featureId], references: [id], onDelete: Restrict)
  route             ModelRoute?        @relation(fields: [routeId], references: [id], onDelete: Restrict)
  routePriceVersion RoutePriceVersion? @relation(fields: [routePriceVersionId], references: [id], onDelete: Restrict)
  featurePrice      FeaturePrice?      @relation(fields: [featurePriceId], references: [id], onDelete: Restrict)

  @@unique([productId, idempotencyKey])
  @@index([status, expiresAt])
  @@index([accountId, productId, status])
}

// ============================================================================
// Метеринг и цены моделей (§10)
// ============================================================================

/// Без FK (инвариант 12). Только дописывается (RAW-триггер).
/// No partitioning; идемпотентность — в UsageEventKey.
/// provider/model пусты у действий без модели (фиксированная цена, системные).
model UsageEvent {
  operationId           String?     @db.Uuid
  planVersionId         String?     @db.Uuid
  isLate                Boolean     @default(false)
  costSource            String
  id                    String      @id @default(uuid(7)) @db.Uuid
  accountId             String      @db.Uuid
  productId             String      @db.Uuid
  actorId               String?     @db.Uuid
  holdId                String?     @db.Uuid
  featureId             String      @db.Uuid
  routeId               String?     @db.Uuid
  provider              String?
  model                 String?
  meters                Json        @default("{}")
  inputTokens           BigInt      @default(0)
  outputTokens          BigInt      @default(0)
  costNanos             BigInt      @default(0)
  routePriceVersionId   String?     @db.Uuid
  markupPolicyVersionId String?     @db.Uuid
  creditRateVersionId   String?     @db.Uuid
  featurePriceId        String?     @db.Uuid
  creditsChargedMilli   BigInt      @default(0)
  status                UsageStatus
  byok                  Boolean     @default(false)
  idempotencyKey        String
  traceId               String?
  rawUsage              Json?
  occurredAt            DateTime    @db.Timestamptz(3)
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)

  @@index([actorId, occurredAt])
  @@index([operationId])
  @@index([planVersionId, occurredAt])
  @@index([accountId, productId, occurredAt])
  @@index([productId, occurredAt])
  @@index([provider, occurredAt])
  @@index([featureId, occurredAt])
  @@index([holdId])
}

/// Идемпотентность UsageEvent в отдельной таблице. Узкая; строки
/// старше срока хранения ключей (настройка, ≥ окна позднего commit) удаляются.
model UsageEventKey {
  productId      String   @db.Uuid
  idempotencyKey String
  usageEventId   String   @db.Uuid // мягкая ссылка
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@id([productId, idempotencyKey])
  @@index([createdAt])
}

/// variant: 'standard' | 'batch' | 'flex' | 'priority' | 'realtime' …
model ModelRoute {
  id        String         @id @default(uuid(7)) @db.Uuid
  provider  String
  model     String
  variant   String         @default("standard")
  kind      ModelRouteKind
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  priceVersions RoutePriceVersion[]
  features      ProductFeature[]
  products      ProductModelRoute[]
  holds         CreditHold[]

  @@unique([provider, model, variant])
}

/// Какие маршруты доступны продукту и какие права нужны (тир модели).
/// Маршрут без строки здесь продукту недоступен.
model ProductModelRoute {
  productId String   @db.Uuid
  routeId   String   @db.Uuid
  /// требования к правам, формат как у ProductFeature.requires
  requires  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  route   ModelRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)

  @@id([productId, routeId])
}

/// publishedAt IS NULL — черновик (в т. ч. от pricing-sync, §10.4).
/// Действует последняя опубликованная с effectiveFrom <= t.
model RoutePriceVersion {
  id            String             @id @default(uuid(7)) @db.Uuid
  routeId       String             @db.Uuid
  version       Int
  effectiveFrom DateTime           @db.Timestamptz(3)
  source        PriceVersionSource
  approvedBy    String?            @db.Uuid // Identity сотрудника
  publishedAt   DateTime?          @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  route ModelRoute       @relation(fields: [routeId], references: [id], onDelete: Restrict)
  items RoutePriceItem[]
  holds CreditHold[]

  @@unique([routeId, version])
  @@index([routeId, effectiveFrom])
}

/// Неизменяема, если версия опубликована (RAW-триггер)
model RoutePriceItem {
  id               String  @id @default(uuid(7)) @db.Uuid
  priceVersionId   String  @db.Uuid
  meter            String // 'input_tokens', 'audio_seconds', ...
  unitNanos        BigInt
  per              BigInt  @default(1) // 1 | 1_000_000 ...
  /// { fromContextTokens: 200000 } и т. п.
  tier             Json?
  minBillableUnits BigInt?

  priceVersion RoutePriceVersion @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)

  @@index([priceVersionId, meter])
}

// ============================================================================
// Подписки и платежи (§12)
// ============================================================================

model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  accountId              String             @db.Uuid
  planVersionId          String             @db.Uuid
  offerId                String?            @db.Uuid
  source                 PaymentSource
  externalSubscriptionId String
  externalCustomerId     String?
  status                 SubscriptionStatus
  currentPeriodStart     DateTime           @db.Timestamptz(3)
  currentPeriodEnd       DateTime           @db.Timestamptz(3)
  trialEndsAt            DateTime?          @db.Timestamptz(3)
  /// начало past_due — отсчёт грейса (§12.2)
  pastDueSince           DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?          @db.Timestamptz(3)
  endedAt                DateTime?          @db.Timestamptz(3)
  /// отложенная смена тарифа (даунгрейд в конце периода, §12.3)
  scheduledPlanVersionId String?            @db.Uuid
  scheduledOfferId       String?            @db.Uuid
  scheduledChangeAt      DateTime?          @db.Timestamptz(3)
  quantity               Int                @default(1)
  /// исходный магазин для revenuecat ('app_store' | 'play_store')
  store                  String?
  lastSyncedAt           DateTime?          @db.Timestamptz(3)
  version                Int                @default(0)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  account              BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  planVersion          PlanVersion    @relation("SubscriptionPlanVersion", fields: [planVersionId], references: [id], onDelete: Restrict)
  offer                Offer?         @relation("SubscriptionOffer", fields: [offerId], references: [id], onDelete: Restrict)
  scheduledPlanVersion PlanVersion?   @relation("SubscriptionScheduledPlanVersion", fields: [scheduledPlanVersionId], references: [id], onDelete: Restrict)
  scheduledOffer       Offer?         @relation("SubscriptionScheduledOffer", fields: [scheduledOfferId], references: [id], onDelete: Restrict)

  payments Payment[]
  events   SubscriptionEvent[]

  @@unique([source, externalSubscriptionId])
  @@index([accountId, status])
  @@index([status, currentPeriodEnd])
  @@index([planVersionId])
}

/// История подписки: смены статуса и тарифа. Только дописывается (RAW-триггер).
model SubscriptionEvent {
  id                String                @id @default(uuid(7)) @db.Uuid
  subscriptionId    String                @db.Uuid
  kind              SubscriptionEventKind
  fromStatus        SubscriptionStatus?
  toStatus          SubscriptionStatus?
  fromPlanVersionId String?               @db.Uuid
  toPlanVersionId   String?               @db.Uuid
  webhookEventId    String?               @db.Uuid // BillingWebhookEvent, мягкая ссылка
  meta              Json                  @default("{}")
  occurredAt        DateTime              @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  fromPlanVersion PlanVersion? @relation("SubEventFromPlan", fields: [fromPlanVersionId], references: [id], onDelete: Restrict)
  toPlanVersion   PlanVersion? @relation("SubEventToPlan", fields: [toPlanVersionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, occurredAt])
}

/// creditsMilli/validityDays — снимок пакета на момент покупки
model Purchase {
  checkoutSessionId String?          @unique @db.Uuid
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  id                String           @id @default(uuid(7)) @db.Uuid
  accountId         String           @db.Uuid
  productId         String           @db.Uuid
  creditPackOfferId String           @db.Uuid
  creditsMilli      BigInt
  validityDays      Int
  source            PaymentSource
  externalId        String?
  status            PurchaseStatus   @default(pending)
  bucketId          String?          @unique @db.Uuid
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  account         BillingAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  creditPackOffer CreditPackOffer @relation(fields: [creditPackOfferId], references: [id], onDelete: Restrict)
  bucket          CreditBucket?   @relation(fields: [bucketId, accountId, productId], references: [id, accountId, productId], onDelete: Restrict)
  payments        Payment[]

  @@unique([source, externalId])
  @@unique([bucketId, accountId, productId])
  @@index([accountId, createdAt])
}

/// planVersionId/offerId — снимок «за что заплачено» на момент платежа:
/// подписка может позже сменить тариф.
/// RAW: CHECK (subscriptionId IS NULL OR purchaseId IS NULL)
model Payment {
  periodStart       DateTime?     @db.Timestamptz(3)
  periodEnd         DateTime?     @db.Timestamptz(3)
  revenueAllocation Json          @default("{}")
  id                String        @id @default(uuid(7)) @db.Uuid
  accountId         String        @db.Uuid
  subscriptionId    String?       @db.Uuid
  purchaseId        String?       @db.Uuid
  planVersionId     String?       @db.Uuid
  offerId           String?       @db.Uuid
  source            PaymentSource
  externalId        String
  kind              PaymentKind
  status            PaymentStatus
  currency          String        @db.Char(3)
  grossMicros       BigInt
  taxMicros         BigInt        @default(0)
  feeMicros         BigInt        @default(0)
  discountMicros    BigInt        @default(0)
  netMicros         BigInt
  grossUsdMicros    BigInt
  netUsdMicros      BigInt
  fxRate            Decimal       @db.Decimal(20, 10)
  fxSource          String
  netIsEstimated    Boolean       @default(false)
  refundedMicros    BigInt        @default(0) // материализация Σ PaymentRefund
  occurredAt        DateTime      @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  account       BillingAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  subscription  Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  purchase      Purchase?           @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  planVersion   PlanVersion?        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  offer         Offer?              @relation(fields: [offerId], references: [id], onDelete: Restrict)
  refunds       PaymentRefund[]
  ledgerEntries CreditLedgerEntry[]

  @@unique([source, externalId])
  @@index([accountId, occurredAt])
  @@index([subscriptionId])
  @@index([purchaseId])
  @@index([planVersionId, occurredAt])
}

/// Только дописывается (RAW-триггер). Сумма положительная, знак задаёт kind.
model PaymentRefund {
  id              String        @id @default(uuid(7)) @db.Uuid
  paymentId       String        @db.Uuid
  source          PaymentSource
  externalId      String
  kind            RefundKind
  amountMicros    BigInt
  amountUsdMicros BigInt
  occurredAt      DateTime      @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([source, externalId, kind])
  @@index([paymentId])
}

/// Тариф без оплаты: free, акция, реферал, бета (§6.2, §13.3).
/// idempotencyKey: 'default:<accountId>', 'referral_reward:<id>' …
model PlanGrant {
  planId         String?         @db.Uuid
  plan           Plan?           @relation(fields: [planId], references: [id], onDelete: Restrict)
  id             String          @id @default(uuid(7)) @db.Uuid
  accountId      String          @db.Uuid
  productId      String          @db.Uuid
  planVersionId  String?         @db.Uuid
  source         PlanGrantSource
  sourceId       String?
  idempotencyKey String
  startsAt       DateTime        @db.Timestamptz(3)
  endsAt         DateTime?       @db.Timestamptz(3) // null = бессрочно
  status         GrantStatus     @default(active)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  account     BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  planVersion PlanVersion?   @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@unique([productId, idempotencyKey])
  @@index([accountId, productId, status])
  @@index([planVersionId])
  @@index([planId])
}

// ============================================================================
// Рефералы (§13, этап 4). ReferralCommission / PartnerPayout — позже (§13.4).
// ============================================================================

model Partner {
  id        String      @id @default(uuid(7)) @db.Uuid
  accountId String      @unique @db.Uuid
  tier      PartnerTier @default(user)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  codes   ReferralCode[]
}

/// Стабильная программа; условия — в неизменяемых версиях
model ReferralProgram {
  id           String                @id @default(uuid(7)) @db.Uuid
  code         String                @unique
  /// коды продуктов (Product.code)
  productScope String[]
  status       ReferralProgramStatus @default(draft)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)

  versions  ReferralProgramVersion[]
  codes     ReferralCode[]
  referrals Referral[]
}

/// Неизменяема после publishedAt (инвариант 7)
model ReferralProgramVersion {
  id            String    @id @default(uuid(7)) @db.Uuid
  programId     String    @db.Uuid
  version       Int
  rules         Json
  effectiveFrom DateTime  @db.Timestamptz(3)
  publishedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  program   ReferralProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  referrals Referral[]

  @@unique([programId, version])
}

model ReferralCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  partnerId  String    @db.Uuid
  programId  String    @db.Uuid
  code       String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  disabledAt DateTime? @db.Timestamptz(3)

  partner   Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  program   ReferralProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  clicks    ReferralClick[]
  referrals Referral[]

  @@index([partnerId])
}

/// Только хэш посетителя (§20)
model ReferralClick {
  id          String   @id @default(uuid(7)) @db.Uuid
  codeId      String   @db.Uuid
  visitorHash String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  code ReferralCode @relation(fields: [codeId], references: [id], onDelete: Restrict)

  @@index([codeId, createdAt])
}

/// programVersionId — версия условий на момент атрибуции (§13.4)
model Referral {
  id                String         @id @default(uuid(7)) @db.Uuid
  codeId            String         @db.Uuid
  programId         String         @db.Uuid
  programVersionId  String         @db.Uuid
  referredAccountId String         @db.Uuid
  productId         String         @db.Uuid // продукт атрибуции
  status            ReferralStatus @default(attributed)
  attributedAt      DateTime       @default(now()) @db.Timestamptz(3)
  convertedAt       DateTime?      @db.Timestamptz(3)

  code             ReferralCode           @relation(fields: [codeId], references: [id], onDelete: Restrict)
  program          ReferralProgram        @relation(fields: [programId], references: [id], onDelete: Restrict)
  programVersion   ReferralProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  referredAccount  BillingAccount         @relation("ReferredAccount", fields: [referredAccountId], references: [id], onDelete: Restrict)
  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  rewards          ReferralReward[]
  checkoutSessions CheckoutSession[]

  @@unique([referredAccountId, productId])
  @@index([codeId])
}

/// Награда получателю: рефереру или приглашённому (role)
model ReferralReward {
  triggerPaymentId     String?              @db.Uuid
  rejectionReason      String?
  fraudSignals         Json                 @default("{}")
  id                   String               @id @default(uuid(7)) @db.Uuid
  referralId           String               @db.Uuid
  beneficiaryAccountId String               @db.Uuid
  role                 ReferralRewardRole
  kind                 ReferralRewardKind
  productId            String               @db.Uuid
  creditsMilli         BigInt?
  planVersionId        String?              @db.Uuid
  durationDays         Int?
  trigger              ReferralTrigger
  status               ReferralRewardStatus @default(pending)
  availableAt          DateTime             @db.Timestamptz(3) // холд против возвратов
  idempotencyKey       String               @unique
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)

  referral           Referral       @relation(fields: [referralId], references: [id], onDelete: Restrict)
  beneficiaryAccount BillingAccount @relation(fields: [beneficiaryAccountId], references: [id], onDelete: Restrict)
  product            Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  planVersion        PlanVersion?   @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@index([triggerPaymentId])
  @@index([status, availableAt])
  @@index([beneficiaryAccountId, createdAt])
  @@index([referralId])
}

// ============================================================================
// Лимиты (§8.8)
// ============================================================================

/// Предохранители продукта / экземпляра. Счётчики — приблизительные, в Redis
/// (не в LimitUsageWindow): общая строка окна стала бы глобальной блокировкой.
model LimitPolicy {
  id        String           @id @default(uuid(7)) @db.Uuid
  productId String?          @db.Uuid
  scope     LimitPolicyScope
  window    LimitWindow
  meter     LimitMeter
  max       BigInt
  action    LimitAction      @default(deny)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// ============================================================================
// Квоты (§14, этап 6)
// ============================================================================

model ProductQuotaKey {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @db.Uuid
  key        String // 'storage.bytes', 'seats', 'projects'
  unit       String // 'bytes' | 'count'
  /// { mode: 'deny'|'read_only', graceDays, retentionEvent? }
  overPolicy Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, key])
}

model QuotaUsage {
  accountId  String    @db.Uuid
  productId  String    @db.Uuid
  key        String
  value      BigInt
  measuredAt DateTime  @db.Timestamptz(3)
  overSince  DateTime? @db.Timestamptz(3) // начало превышения (грейс)

  account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([accountId, productId, key])
}

model QuotaReservation {
  id              String                 @id @default(uuid(7)) @db.Uuid
  accountId       String                 @db.Uuid
  productId       String                 @db.Uuid
  key             String
  amount          BigInt
  committedAmount BigInt?
  status          QuotaReservationStatus @default(open)
  idempotencyKey  String
  expiresAt       DateTime               @db.Timestamptz(3)
  closedAt        DateTime?              @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)

  account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, idempotencyKey])
  @@index([accountId, productId, key, status])
  @@index([status, expiresAt])
}

model QuotaUsageSnapshot {
  accountId String   @db.Uuid
  productId String   @db.Uuid
  key       String
  day       DateTime @db.Date
  value     BigInt
  peak      BigInt

  account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([accountId, productId, key, day])
}

// ============================================================================
// Служебные таблицы (§16.4)
// ============================================================================

model ProductApiKey {
  id         String       @id @default(uuid(7)) @db.Uuid
  productId  String       @db.Uuid
  name       String?
  keyHash    String       @unique // SHA-256
  prefix     String
  scopes     String[]
  status     ApiKeyStatus @default(active)
  lastUsedAt DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime?    @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
}

model ProductWebhookEndpoint {
  id              String         @id @default(uuid(7)) @db.Uuid
  productId       String         @db.Uuid
  url             String
  secretEncrypted String
  events          String[]
  status          EndpointStatus @default(active)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  product    Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveries OutboxDelivery[]

  @@index([productId])
}

/// Исходящее событие продукту (§16.3). Доставка — по строке на эндпоинт.
/// dedupeKey защищает от повторной генерации (напр. 'balance.low:<wallet>:<day>').
model OutboxEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String?  @db.Uuid
  type      String
  payload   Json
  dedupeKey String?  @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  product    Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveries OutboxDelivery[]

  @@index([productId, createdAt])
}

model OutboxDelivery {
  id            String       @id @default(uuid(7)) @db.Uuid
  eventId       String       @db.Uuid
  endpointId    String       @db.Uuid
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)
  deliveredAt   DateTime?    @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  event    OutboxEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint ProductWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
}

/// Inbox вебхуков источников оплаты (§11.5). payload содержит PII:
/// обнуляется воркером через срок хранения (payloadPurgedAt).
model BillingWebhookEvent {
  accountId       String?       @db.Uuid
  id              String        @id @default(uuid(7)) @db.Uuid
  source          PaymentSource
  externalEventId String
  type            String?
  payload         Json?
  payloadPurgedAt DateTime?     @db.Timestamptz(3)
  status          InboxStatus   @default(received)
  attempts        Int           @default(0)
  processedAt     DateTime?     @db.Timestamptz(3)
  error           String?
  receivedAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([source, externalEventId])
  @@index([accountId])
  @@index([status, receivedAt])
}

model EntitlementOverride {
  targetKind String    @default("entitlement")
  id         String    @id @default(uuid(7)) @db.Uuid
  accountId  String    @db.Uuid
  productId  String    @db.Uuid
  key        String
  value      Json
  reason     String
  createdBy  String    @db.Uuid // Identity сотрудника
  expiresAt  DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([accountId, productId])
}

model LimitOverride {
  id        String    @id @default(uuid(7)) @db.Uuid
  accountId String    @db.Uuid
  productId String    @db.Uuid
  rule      Json // LimitRule
  reason    String
  createdBy String    @db.Uuid
  expiresAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([accountId, productId])
}

model StaffRole {
  identityId String        @db.Uuid
  role       StaffRoleKind
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@id([identityId, role])
}

/// before/after — без PII (email, subject): ссылки на внутренние id
model AdminAuditLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  actorIdentityId String   @db.Uuid
  action          String
  targetType      String
  targetId        String
  before          Json?
  after           Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  actor Identity @relation(fields: [actorIdentityId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// accountId — чтобы стереть письма аккаунта при удалении (§20);
/// отправленные письма чистятся через срок хранения.
model MailOutbox {
  locale        String       @default("en-US")
  id            String       @id @default(uuid(7)) @db.Uuid
  accountId     String?      @db.Uuid // мягкая ссылка
  to            String
  template      String
  data          Json
  dedupeKey     String?      @unique // 'pack_expiry_30d:<bucketId>'
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)
  sentAt        DateTime?    @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([accountId])
}

model AdminTask {
  id         String    @id @default(uuid(7)) @db.Uuid
  kind       String
  dedupeKey  String    @unique
  accountId  String?   @db.Uuid
  status     String    @default("open")
  details    Json      @default("{}")
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)

  @@index([status, createdAt])
}

model IdentityBinding {
  id         String    @id @default(uuid(7)) @db.Uuid
  identityId String    @db.Uuid
  issuer     String?
  subject    String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@unique([issuer, subject])
  @@index([identityId])
}

/// productId — продукт, который создал checkout (его ключ API или страница);
/// ключ идемпотентности — в его пространстве, как у остальных операций.
/// RAW: CHECK ((offerId IS NULL) <> (creditPackOfferId IS NULL))
model CheckoutSession {
  id                String                @id @default(uuid(7)) @db.Uuid
  accountId         String                @db.Uuid
  productId         String                @db.Uuid
  source            PaymentSource
  externalId        String?
  idempotencyKey    String
  offerId           String?               @db.Uuid
  creditPackOfferId String?               @db.Uuid
  promotionId       String?               @db.Uuid
  referralId        String?               @db.Uuid
  returnUrl         String
  status            CheckoutSessionStatus @default(pending)
  expiresAt         DateTime              @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)

  account         BillingAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  offer           Offer?           @relation(fields: [offerId], references: [id], onDelete: Restrict)
  creditPackOffer CreditPackOffer? @relation(fields: [creditPackOfferId], references: [id], onDelete: Restrict)
  promotion       Promotion?       @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  referral        Referral?        @relation(fields: [referralId], references: [id], onDelete: Restrict)
  purchase        Purchase?

  @@unique([productId, idempotencyKey])
  @@unique([source, externalId])
  @@index([accountId, createdAt])
  @@index([status, expiresAt])
}

/// Долговечные окна лимитов клиента (LimitRule, scope actor/account) — §8.8.
/// Для LimitPolicy (product/deployment) строки не создаются.
model LimitUsageWindow {
  scopeKey    String
  windowStart DateTime   @db.Timestamptz(3)
  windowEnd   DateTime   @db.Timestamptz(3)
  meter       LimitMeter
  consumed    BigInt     @default(0)
  reserved    BigInt     @default(0)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@id([scopeKey, windowStart, meter])
  @@index([windowEnd])
}
