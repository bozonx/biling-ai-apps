generator client {
  provider     = "prisma-client"
  moduleFormat = "esm"
  output       = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
}
