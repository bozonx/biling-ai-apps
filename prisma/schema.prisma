// Схема БД биллинг-сервиса. Источник: dev_docs/billing-service-design.md (v5).
//
// Соглашения (§2):
//  - PK — UUIDv7 (инвариант 12). Все метки времени — timestamptz, UTC.
//  - Деньги — BigInt, микроединицы (1_000_000 = 1 USD); себестоимость AI — нано-USD.
//  - Кредиты — BigInt, милли-кредиты (1000 = 1 кредит).
//  - Только дописываются (триггер запрещает UPDATE/DELETE): CreditOperation,
//    CreditLedgerEntry, UsageEvent, PaymentRefund, SubscriptionEvent.
//  - Версии после publishedAt неизменяемы (триггер, инвариант 7).
//  - Таблицы не партиционируются; идемпотентность — в отдельных ключах операций.
//  - Ссылки на UsageEvent и из него — мягкие (без FK).
//  - Prisma не управляет CHECK и триггерами — они в сырых миграциях
//    (помечены «RAW»). Частичных индексов и NULLS NOT DISTINCT нет намеренно:
//    Prisma видит их как дрейф.
//  - Внешние идентификаторы людей (issuer/subject/email) живут только в
//    IdentityBinding и BillingAccount (инвариант 11).
//  - Product.code неизменяем: на него ссылаются Plan.productScope и ключи JSON
//    в PlanVersion.
//  - Связи по умолчанию onDelete: Restrict — финансовые записи не удаляются
//    каскадом и не теряют ссылок.

generator client {
  provider     = "prisma-client"
  moduleFormat = "esm"
  output       = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum ProductStatus {
  active
  disabled
}

enum AccountKind {
  personal
  team // в v1 не создаётся (§5.3)
}

enum AccountStatus {
  active
  suspended
  deleted
}

enum PaymentSource {
  paddle
  polar
  revenuecat
  manual
}

enum EntitlementType {
  bool
  int
  enum
}

enum EntitlementMerge {
  max
  or
  // 'sum' между базовыми источниками запрещён (§6.3)
}

enum PlanKind {
  base
  addon
  bundle
}

enum Visibility {
  public
  unlisted
  archived
}

enum BillingInterval {
  day
  week
  month
  year
}

enum FeaturePricing {
  fixed
  metered
}

enum FeatureStatus {
  active
  disabled
}

enum PromotionKind {
  discount // ссылка на купон MoR
  grant // «при оплате X выдать Y»
}

enum CreditBucketKind {
  plan
  pack
  promo
  referral
  compensation
  trial
}

enum CreditSourceType {
  subscription
  plan_grant
  purchase
  promotion
  referral_reward
  manual
}

enum LedgerReason {
  accrual
  purchase
  consumption
  expiry
  refund
  revoke
  adjustment
  referral_reward
  promo
  debt
  debt_repayment
}

enum CreditOperationKind {
  accrual // начисление порции тарифа/гранта, доплата при апгрейде
  purchase
  grant // промо, реферал, компенсация, ручное
  commit
  expiry
  refund
  revoke
  adjustment
}

enum HoldKind {
  hold
  lease
}

enum HoldStatus {
  open
  committed
  released
  expired
}

enum UsageStatus {
  ok
  error
  partial
}

enum ModelRouteKind {
  llm
  stt
  tts
  image
  video
  mt
  embed
}

enum PriceVersionSource {
  manual
  seed
  sync
  provider_api @map("provider-api")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  read_only
  expired
  // paused — добавится вместе с RevenueCat (этап 7)
}

enum SubscriptionEventKind {
  created
  status_changed
  plan_changed
  change_scheduled
  change_canceled
  cancel_scheduled
  cancel_reverted
  period_renewed
}

enum PurchaseStatus {
