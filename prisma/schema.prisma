  paid
  refunded
  failed
  partially_refunded
  chargeback
}

enum PaymentKind {
  subscription_initial
  subscription_renewal
  subscription_change
  one_time
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
  chargeback
}

enum RefundKind {
  refund
  chargeback
  chargeback_reversal // спор выигран; сумма положительная, знак задаёт kind
}

enum PlanGrantSource {
  default
  referral
  promo
  manual
  beta
}

enum GrantStatus {
  active
  ended
  revoked
  converted // сконвертирован в кредиты (rules.fallbackCredits, §13.3)
