{
  "name": "billing-ai-apps",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:web": "pnpm --filter @billing/web test",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:e2e": "playwright test",
    "typecheck": "pnpm exec turbo run build --filter=\"./packages/*\" && tsc --noEmit && pnpm --filter @billing/web typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm check:env",
    "check:env": "node scripts/check-env-docs.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "dotenv": "catalog:",
    "pg": "catalog:",
    "prisma": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@testcontainers/redis": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "bullmq": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "ts-jest": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "jose": "catalog:",
    "fastify": "catalog:",
    "nock": "catalog:",
    "reflect-metadata": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/platform-fastify": "catalog:"
  },
  "type": "module"
}
