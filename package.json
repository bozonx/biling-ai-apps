{
  "name": "billing-ai-apps",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:web": "pnpm --filter @billing/web test",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && pnpm --filter @billing/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm check:env",
    "check:env": "node scripts/check-env-docs.mjs"
  },
  "dependencies": {
    "@prisma/client": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "pg": "catalog:",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "prisma": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "prettier": "catalog:",
    "@playwright/test": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@testcontainers/redis": "catalog:",
    "bullmq": "catalog:"
  }
}
