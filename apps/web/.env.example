# Web portal. Copy to apps/web/.env; Nuxt reads only its own directory.
# Values are read at runtime, NUXT_PUBLIC_* are exposed to the browser.

# API origin for the server-side proxy of /api/v1/**
NUXT_API_URL=http://localhost:3010
NUXT_PUBLIC_APP_NAME=Billing AI
# Developer sign-in; the API must also have DEV_ACCOUNT_ENABLED=true
NUXT_PUBLIC_DEV_LOGIN_ENABLED=false
