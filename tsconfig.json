{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node20",
    "moduleResolution": "Node16",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node", "jest"],
    "rootDir": "."
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/gateway/src/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "prisma/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
